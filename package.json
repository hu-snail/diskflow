{
  "name": "diskflow",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "DiskFlow — 跨平台磁盘空间分析与迁移工具 (Tauri + Vue 3)",
  "author": "DiskFlow Team",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "scripts": {
    "_comment_frontend": "─── 前端 Vite ───",
    "dev": "vite",
    "dev:web": "vite --host 0.0.0.0",
    "build": "vue-tsc --noEmit && vite build",
    "build:web": "vite build",
    "preview": "vite preview",
    "preview:web": "vite preview --host 0.0.0.0",
    "_comment_desktop": "─── Tauri 桌面 (开发 + 调试) ───",
    "dev:desktop": "tauri dev",
    "dev:desktop:debug": "tauri dev --debug",
    "tauri": "tauri",
    "_comment_build_desktop": "─── Tauri 桌面打包 ───",
    "build:desktop": "tauri build",
    "build:desktop:debug": "tauri build --debug",
    "_comment_platform": "─── 多端平台打包 ───",
    "build:mac": "tauri build --target aarch64-apple-darwin",
    "build:mac:intel": "tauri build --target x86_64-apple-darwin",
    "build:mac:universal": "tauri build --target universal-apple-darwin",
    "build:win": "tauri build --target x86_64-pc-windows-msvc",
    "build:win:arm": "tauri build --target aarch64-pc-windows-msvc",
    "build:linux": "tauri build --target x86_64-unknown-linux-gnu",
    "build:linux:arm": "tauri build --target aarch64-unknown-linux-gnu",
    "build:all": "npm run build:mac:universal && npm run build:win && npm run build:linux",
    "_comment_target_add": "─── 目标平台安装 (首次打包前) ───",
    "target:add:mac": "rustup target add aarch64-apple-darwin x86_64-apple-darwin",
    "target:add:mac:universal": "rustup target add aarch64-apple-darwin x86_64-apple-darwin && cargo install tauri-cli --version '^2.0'",
    "target:add:win": "rustup target add x86_64-pc-windows-msvc",
    "target:add:linux": "rustup target add x86_64-unknown-linux-gnu",

    "_comment_preview_desktop": "─── 桌面预览 (生产构建后) ───",
    "preview:desktop": "tauri build --debug && open src-tauri/target/debug/bundle/macos/DiskFlow.app 2>/dev/null || true",

    "_comment_quality": "─── 代码质量 ───",
    "lint": "vue-tsc --noEmit",
    "typecheck": "vue-tsc --noEmit",
    "format:check": "echo '未配置 Prettier' && exit 0",
    "rust:check": "cd src-tauri && cargo check",
    "rust:clippy": "cd src-tauri && cargo clippy --all-targets -- -D warnings",
    "rust:fmt:check": "cd src-tauri && cargo fmt --check",
    "rust:fmt": "cd src-tauri && cargo fmt",
    "verify": "npm run lint && npm run rust:check",

    "_comment_release": "─── 发布 ───",
    "release:patch": "npm version patch && npm run build:desktop",
    "release:minor": "npm version minor && npm run build:desktop",
    "release:major": "npm version major && npm run build:desktop",
    "version:check": "node -e \"const p=require('./package.json'); console.log(p.name, p.version)\"",

    "_comment_clean": "─── 清理 ───",
    "clean": "rm -rf dist node_modules/.vite src-tauri/target",
    "clean:dist": "rm -rf dist"
  },
  "dependencies": {
    "vue": "^3.4.0",
    "naive-ui": "^2.38.0",
    "@vicons/tabler": "^0.12.0",
    "@vicons/ionicons5": "^0.12.0",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-fs": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "@tauri-apps/plugin-shell": "^2.0.0",
    "@tauri-apps/plugin-os": "^2.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vue-tsc": "^2.0.0"
  }
}
